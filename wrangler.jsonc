// Cloudflare ayar dosyası — yalnızca Cloudflare "Workers" ile yayınlanırsa kullanılır.
// Cloudflare Pages ile yayında bu dosyaya gerek yoktur; Pages onu atlar.
// Yayınlanan klasör: site/ (derleme adımı yok, dosyalar olduğu gibi yayınlanır).
{
  "name": "seovisi-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
